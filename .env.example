# Copy to .env and adjust. Never commit the filled-in file.

# --- runtime ---
APP_ENV=development
LOG_LEVEL=info

# --- datastores ---
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=eproc
# 6379 sering sudah dipakai instance Redis lain; compose memetakan ke 6380.
REDIS_ADDR=localhost:6380
REDIS_PASSWORD=
REDIS_DB=0

# --- message broker ---
RABBITMQ_URL=amqp://eproc:eproc@localhost:5672/
RABBITMQ_USER=eproc
RABBITMQ_PASSWORD=eproc

# --- auth ---
JWT_SECRET=dev-secret-change-me
JWT_TTL=12h

# --- business rules ---
# Purchase orders at or above this amount require approval.
APPROVAL_THRESHOLD=50000000

# --- service ports (override per service) ---
HTTP_ADDR=:8080
GRPC_ADDR=:9090
RATE_LIMIT_RPS=50

# --- frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
