# Next.js production image (standalone output).
#
# The pnpm store lives in a BuildKit cache mount and the install retries a couple
# of times: on a slow or flaky link an npm fetch can drop mid-download, and
# without the cache every retry would start from an empty store.
FROM node:24-alpine AS deps
WORKDIR /app
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable

# The lockfile alone is not enough: pnpm-workspace.yaml carries the allowBuilds
# policy (which dependency build scripts are permitted). Without it pnpm v11
# treats an unapproved build script as an error inside the image, while the same
# install succeeds on the host that has the file.
COPY web/package.json web/pnpm-lock.yaml* web/pnpm-workspace.yaml* ./
RUN --mount=type=cache,target=/pnpm/store \
    pnpm config set store-dir /pnpm/store && \
    pnpm config set fetch-retries 6 && \
    pnpm config set fetch-retry-mintimeout 20000 && \
    pnpm config set fetch-retry-maxtimeout 120000 && \
    pnpm config set fetch-timeout 300000 && \
    for attempt in 1 2 3; do \
        if pnpm install --frozen-lockfile --network-concurrency 4; then break; fi; \
        if [ "$attempt" = "3" ]; then echo "pnpm install failed after 3 attempts" >&2; exit 1; fi; \
        echo "pnpm install attempt $attempt failed, retrying in 10s" >&2; \
        sleep 10; \
    done

FROM node:24-alpine AS builder
WORKDIR /app
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable

COPY --from=deps /app/node_modules ./node_modules
COPY web/ ./
ARG NEXT_PUBLIC_API_URL=http://localhost:8000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm build

FROM node:24-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
# Docker sets HOSTNAME to the container id, and Next's standalone server binds to
# whatever HOSTNAME holds — so without this the app listens only on the container's
# own IP and an in-container probe against 127.0.0.1 gets "Connection refused"
# while the published port still works from outside. Pinning it to 0.0.0.0 makes
# loopback and the container network both reachable.
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
RUN addgroup -g 10001 -S nodejs && adduser -S nextjs -u 10001
COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
